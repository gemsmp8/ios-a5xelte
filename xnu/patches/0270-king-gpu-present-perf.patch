--- a/bsd/dev/herolte_gpu.c
+++ b/bsd/dev/herolte_gpu.c
@@ -927,6 +927,10 @@ static uint64_t hgp_next_va = HGP_VA_BASE;
 static vm_offset_t hgp_scr;
 static int hgp_state;                   /* 0 not set up, 1 ready, -1 failed */
 static uint64_t hgp_frames;
+static uint64_t hgp_gpu_total_ns;
+static uint64_t hgp_fps_window_start;
+static uint64_t hgp_fps_window_frames;
+static uint64_t hgp_avg_fps_x10;        /* average fps * 10 over the last window */

 /* Wait (bounded) for AS0 to finish its command. */
 static bool
@@ -1090,6 +1094,10 @@ herolte_gpu_present_draw(int s, uint32_t off, uint32_t stride, uint32_t w, uint
 	    w > 0x10000 || h > 0x10000) {
 		return false;
 	}
+	extern uint64_t mach_absolute_time(void);
+	extern void absolutetime_to_nanoseconds(uint64_t, uint64_t *);
+	uint64_t t0 = mach_absolute_time();
+
 	vm_offset_t scr = hgp_scr;
 	/* IEEE bits of w and h (integers below 2^24, so exact). */
 	uint32_t fw = 0, fh = 0;
@@ -1119,18 +1127,43 @@ herolte_gpu_present_draw(int s, uint32_t off, uint32_t stride, uint32_t w, uint
 	hg_run_quiet = true;
 	hg_affinity = hg_rd(hg_gpu, SHADER_PRESENT_LO);
 	hg_job_va = HG_SCR_VA + S_TILER_JOB;
 	hg_job_cpu = scr + S_TILER_JOB;
 	bool ok = hg_run(1, "PRESENT tiler job");
 	if (ok) {
 		hg_job_va = HG_SCR_VA + S_FRAG_JOB;
 		hg_job_cpu = scr + S_FRAG_JOB;
 		ok = hg_run(0, "PRESENT fragment job");
 	}
 	hg_job_va = HG_TEST_VA;
 	hg_job_cpu = 0;
 	hg_affinity = 1;
 	hg_run_quiet = false;
-	if (++hgp_frames <= 3 || !ok) {
-		printf("HEROLTE GPU PRESENT: frame %llu %ux%u stride %u slot %d -> %s\n",
-		    hgp_frames, w, h, stride, s, ok ? "ok" : "failed");
+	uint64_t t1 = mach_absolute_time();
+	uint64_t gpu_ns = 0;
+	absolutetime_to_nanoseconds(t1 - t0, &gpu_ns);
+	hgp_gpu_total_ns += gpu_ns;
+	++hgp_frames;
+	/* GPU-present FPS: how often the Mali scaling draw runs.
+	 * This is NOT CoreAnimation's rendering FPS: CA may produce frames
+	 * slower than the GPU can scale them. The bottleneck is typically
+	 * the CA CPU render (3-11 fps), not this GPU scaling (~4 ms). */
+	hgp_fps_window_frames++;
+	uint64_t wall_ns = 0;
+	if (hgp_fps_window_start == 0) {
+		hgp_fps_window_start = t1;
+	}
+	absolutetime_to_nanoseconds(t1 - hgp_fps_window_start, &wall_ns);
+	if (wall_ns >= 1000000000ULL && hgp_fps_window_frames > 0) {
+		hgp_avg_fps_x10 = hgp_fps_window_frames * 10000000000ULL / wall_ns;
+		hgp_fps_window_start = t1;
+		hgp_fps_window_frames = 0;
+	}
+	if (hgp_frames <= 3 || !ok || (hgp_frames % 300 == 0)) {
+		printf("HEROLTE GPU PRESENT: frame %llu %ux%u stride %u slot %d -> %s "
+		    "(gpu_draw %llu us, gpu_present_fps %llu.%llu)\n",
+		    hgp_frames, w, h, stride, s, ok ? "ok" : "failed",
+		    (unsigned long long)(gpu_ns / 1000),
+		    (unsigned long long)(hgp_avg_fps_x10 / 10),
+		    (unsigned long long)(hgp_avg_fps_x10 % 10));
 	}
 	return ok;
 }
